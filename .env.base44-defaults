# Base44 dev defaults — placeholders so the app boots before Deriv credentials
# are provided. Real values are delivered via /run/base44/app.env (platform
# secrets), which overrides these because it is listed last in compose env_file.
#
# The app renders live charts/ticks from the Deriv public WebSocket without
# these; they are only needed for OAuth login and trading.

NEXT_PUBLIC_DERIV_APP_ID=
NEXT_PUBLIC_DERIV_APP_NAME=EPITOME TRADERS
NEXT_PUBLIC_DERIV_ENV=production
NEXT_PUBLIC_DERIV_OAUTH_SCOPES=trade,account_manage
NEXT_PUBLIC_DERIV_REDIRECT_URI=
NEXT_PUBLIC_DERIV_REFERRAL_LINK=
NEXT_PUBLIC_DERIV_SHOW_APP_NAME=true
NEXT_PUBLIC_FONT_FAMILY=Inter
NEXT_PUBLIC_BASE_PATH=
